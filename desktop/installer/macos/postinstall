#!/bin/sh
# Installer runs this after installing the app. No downloads or terminal for the user.
set -eu
console_user=$(/usr/bin/stat -f '%Su' /dev/console)
case "$console_user" in root|loginwindow|_mbsetupuser|'')
  echo 'Masaüstü kısayolu için oturum açmış bir kullanıcı gerekli.' >&2
  exit 1;;
esac
user_home=$(/usr/bin/dscl . -read "/Users/$console_user" NFSHomeDirectory | /usr/bin/cut -d ' ' -f 2-)
case "$user_home" in /*) ;; *) exit 1;; esac
app_path='/Applications/LS MoldWorks.app'
desktop_link="$user_home/Desktop/LS MoldWorks.app"
if [ -e "$desktop_link" ] && [ ! -L "$desktop_link" ]; then
  desktop_link="$user_home/Desktop/LS MoldWorks (Uygulama).app"
fi
if [ -e "$desktop_link" ] && [ ! -L "$desktop_link" ]; then
  echo 'Masaüstünde aynı isimli dosya var; dosya korunuyor.' >&2
  exit 1
fi
/bin/ln -sfn "$app_path" "$desktop_link"
/usr/sbin/chown -h "$console_user" "$desktop_link"
exit 0
